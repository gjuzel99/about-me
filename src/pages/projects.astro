---
import Layout from '../components/Layout.astro';
import Projects from '../components/Projects.astro';
import { site } from '../data/site';
---

<Layout
  title="Projects"
  description={`Projects, open-source work, and engineering experiments by ${site.author.name}.`}
  image="/img/og.jpg"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Things I build</h1>

      <p
        class="muted"
        style="max-width: 680px; margin: 0;"
      >
        Projects where I explore software engineering, architecture,
        developer tooling, and technologies around Dynamics 365 CE and the
        Power Platform.
      </p>
    </div>
  </section>
  <Projects />
</Layout>